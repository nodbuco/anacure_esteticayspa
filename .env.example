# Copia este archivo como .env.local y completa los valores. .env.local nunca se sube a git.

# Easy!Appointments (solo servidor; nunca exponer al navegador)
EA_BASE_URL=https://spa.agenda.nodbu.com/index.php/api/v1
EA_API_KEY=pega_aqui_el_token

# Sitio
NEXT_PUBLIC_SITE_URL=https://anacure.co

# Analítica (Plausible autoalojado). Déjalo vacío hasta que el servidor esté listo.
# Ejemplo: NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.nodbu.com
NEXT_PUBLIC_PLAUSIBLE_HOST=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=anacure.co

# Blog (Keystatic en modo GitHub). Sin estas variables el editor funciona en modo local (solo desarrollo).
# Se crean con una GitHub App: https://keystatic.com/docs/github-mode
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
